# Copy this file to .env on the Dockge host. Replace every placeholder first.
# Generate the database password with: openssl rand -hex 32
# Use the same hex value in POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_DB=zetas
POSTGRES_USER=zetas_app
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
DATABASE_URL=postgresql://zetas_app:REPLACE_WITH_THE_SAME_64_HEX_CHARACTERS@db:5432/zetas

# Generate separately with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS

# Publish the web entrypoint on loopback for a TLS reverse proxy on the host.
APP_PORT=8080
# One trusted proxy hop by default. Set only after verifying your proxy chain.
TRUST_PROXY_HOPS=1
